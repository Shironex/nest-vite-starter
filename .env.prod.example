# =============================================================================
# Settings for docker-compose.prod.yml. Copy to .env next to it and fill in.
#
#   cp .env.prod.example .env
#   docker compose -f docker-compose.prod.yml up -d
#
# Compose reads this file for the ${...} values in the compose file and passes
# the api its production environment from them. The api refuses to start when a
# value breaks its rules (apps/api/src/config/env.ts); the full list of api keys
# is in .env.example. Every value below is a placeholder: generate real secrets,
# never commit a filled .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Public address
# -----------------------------------------------------------------------------
# The public origin of the web, as browsers see it: base of every mailed link
# and the default CORS origin. Production refuses localhost.
APP_URL=https://app.example.com
# Product name in mail and the UI. Empty uses the built-in name.
APP_NAME=
# Comma list of extra CORS origins (bare origins). Empty means APP_URL's origin.
CORS_ORIGINS=

# Reverse-proxy hops in front of the api: 1 when browsers reach the web
# container directly, 2 with one more proxy in front of it (a host reverse
# proxy or cloudflared). A wrong value makes every client share one IP and the
# per-IP login limits lock everyone out together. Never true.
TRUST_PROXY=1

# debug, info, warn or error.
LOG_LEVEL=info

# Loopback ports published on the host.
WEB_PORT=8080
API_PORT=3000

# -----------------------------------------------------------------------------
# Database and Valkey. The password goes into a connection URL, so use only
# letters and digits: `openssl rand -hex 24`.
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=nest_vite_starter
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------
# 32+ bytes: `openssl rand -hex 32`.
CSRF_SECRET=
# Exactly 32 bytes as base64 or hex: `openssl rand -base64 32`. One per environment.
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Mail. Production needs a real relay, reached over TLS.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@example.com
SMTP_REQUIRE_TLS=true

# -----------------------------------------------------------------------------
# Captcha (Cloudflare Turnstile). Production refuses an empty secret and
# Cloudflare's test secrets. To run without a captcha, leave
# TURNSTILE_SECRET_KEY empty and set CAPTCHA_DISABLED=true.
# -----------------------------------------------------------------------------
# Secret, read by the api.
TURNSTILE_SECRET_KEY=
CAPTCHA_DISABLED=false
# Public site key, written into the web's /config.js at container start. Empty
# falls back to the always-pass test widget.
TURNSTILE_SITE_KEY=

# -----------------------------------------------------------------------------
# Error reporting. Empty means Sentry is never initialised.
# -----------------------------------------------------------------------------
API_SENTRY_DSN=
# Public DSN for the browser, written into /config.js at container start.
WEB_SENTRY_DSN=

# -----------------------------------------------------------------------------
# Images (deploys only). Leave unset to build from this checkout. To deploy
# published images, set both and run `pull` then `up -d --no-build`.
# -----------------------------------------------------------------------------
# API_IMAGE=
# WEB_IMAGE=
# Public origin of the api when it is NOT served through the web container,
# for example https://api.example.com. Empty keeps everything same-origin.
# WEB_API_URL=
