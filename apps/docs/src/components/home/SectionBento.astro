---
import Icon from './Icon.astro';

type Variant = 'signature' | 'brand' | 'plain' | 'terminal';

interface Cell {
  variant: Variant;
  span: 'wide' | 'narrow';
  icon: 'building' | 'shield' | 'layout-dashboard' | 'history';
  title: string;
  href: string;
  desc: string;
  tags: string[];
  terminal?: boolean;
}

// Four differentiated cells: a dark signature Architecture cell, a brand-tint
// Backend cell, a plain Frontend cell, and a terminal-accent Operations cell.
// Descriptions are the real section blurbs from the docs index.
const rows: Cell[][] = [
  [
    {
      variant: 'signature',
      span: 'wide',
      icon: 'building',
      title: 'Architecture',
      href: '/architecture/monorepo-overview/',
      desc: 'Workspace layout, the end-to-end type-safety chain, the data layer, environments, and the build and DX pipeline.',
      tags: ['monorepo', 'type-safety', 'data-layer', 'environments'],
    },
    {
      variant: 'brand',
      span: 'narrow',
      icon: 'shield',
      title: 'Backend',
      href: '/backend/auth-and-sessions/',
      desc: 'NestJS API: authentication and sessions, tenancy scoping, and the user and account lifecycle.',
      tags: ['auth', 'sessions', 'tenancy'],
    },
  ],
  [
    {
      variant: 'plain',
      span: 'narrow',
      icon: 'layout-dashboard',
      title: 'Frontend and Desktop',
      href: '/frontend/web-architecture/',
      desc: 'The Vite and React web app, feature-folder architecture, the shared UI package, the Electron desktop shell, and frontend testing.',
      tags: ['vite', 'tanstack', 'electron'],
    },
    {
      variant: 'terminal',
      span: 'wide',
      icon: 'history',
      title: 'Operations',
      href: '/operations/ci-cd/',
      desc: 'CI/CD, observability, security posture, load testing, and the overall testing strategy.',
      tags: ['$ pnpm ci:local', 'observability', 'load-tests'],
      terminal: true,
    },
  ],
];
---

<section class="bento" aria-labelledby="bento-heading">
  <header class="bento__head">
    <span class="sst-eyebrow">Explore the docs</span>
    <h2 id="bento-heading" class="sst-display bento__title">
      Four sections, each written to stand on its own.
    </h2>
    <p class="bento__sub">
      Autogenerated from Markdown under <code>src/content/docs</code>. Drop a file
      in the right folder and it joins the sidebar on the next build.
    </p>
  </header>

  <div class="bento__grid">
    {
      rows.map((row) => (
        <div class="bento__row">
          {row.map((cell) => (
            <a
              class={`bento__cell bento__cell--${cell.variant} bento__cell--${cell.span}`}
              href={cell.href}
            >
              <div class="bento__cell-head">
                <span class="bento__icon">
                  <Icon name={cell.icon} size={22} />
                </span>
                {cell.terminal && (
                  <span class="bento__dots" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                  </span>
                )}
                <span class="bento__chevron" aria-hidden="true">
                  <Icon name="chevron-right" size={16} />
                </span>
              </div>

              <h3 class="bento__cell-title">{cell.title}</h3>
              <p class="bento__cell-desc">{cell.desc}</p>

              <div class="bento__tags">
                {cell.tags.map((t) => (
                  <span class="sst-tag bento__tag">{t}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
      ))
    }
  </div>
</section>

<style>
  .bento {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding-block: 1.75rem;
  }

  .bento__head {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .bento__title {
    font-size: clamp(1.75rem, 3vw, 2rem);
    letter-spacing: -0.025em;
  }

  .bento__sub {
    margin: 0;
    max-width: 60ch;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--sst-text-secondary);
  }

  .bento__sub code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 0.05rem 0.3rem;
    border-radius: 5px;
    background: var(--sst-subtle);
    border: 1px solid var(--sst-border);
    color: var(--sst-text-secondary);
  }

  .bento__grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .bento__row {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 52rem) {
    .bento__row {
      flex-direction: row;
    }

    .bento__cell--wide {
      flex: 1.85;
    }

    .bento__cell--narrow {
      flex: 1;
    }
  }

  .bento__cell {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 17.5rem;
    padding: 1.625rem 1.75rem;
    border-radius: 16px;
    border: 1px solid var(--sst-border);
    background: var(--sst-surface);
    color: var(--sst-text);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
  }

  .bento__cell--signature {
    background: var(--sst-signature-bg);
    border-color: var(--sst-signature-border);
    color: var(--sst-signature-text);
    box-shadow: var(--sst-shadow-signature);
  }

  .bento__cell--brand {
    background: var(--sst-brand-50);
    border-color: var(--sst-brand-200);
  }

  .bento__cell--plain {
    background: var(--sst-surface);
  }

  .bento__cell--terminal {
    background: var(--sst-subtle);
  }

  .bento__cell-head {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .bento__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 12px;
  }

  .bento__cell--signature .bento__icon {
    background: var(--sst-signature-surface);
    color: var(--sst-signature-text);
  }

  .bento__cell--brand .bento__icon {
    background: var(--sst-brand);
    color: var(--sst-brand-fg);
  }

  .bento__cell--plain .bento__icon {
    background: var(--sst-brand-100);
    color: var(--sst-brand-ink);
  }

  .bento__cell--terminal .bento__icon {
    background: var(--sst-success-bg);
    color: var(--sst-success);
  }

  .bento__dots {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .bento__dots span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
  }

  .bento__dots span:nth-child(1) {
    background: #e5484d;
  }
  .bento__dots span:nth-child(2) {
    background: #e8b93e;
  }
  .bento__dots span:nth-child(3) {
    background: var(--sst-success);
  }

  .bento__chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin-left: auto;
    border-radius: 999px;
    background: var(--sst-subtle);
    color: var(--sst-text-secondary);
    transition:
      transform 0.18s ease,
      background-color 0.18s ease;
  }

  .bento__cell--signature .bento__chevron,
  .bento__cell--brand .bento__chevron {
    background: var(--sst-brand);
    color: var(--sst-brand-fg);
  }

  .bento__cell-title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
    margin: 0;
    color: inherit;
  }

  .bento__cell-desc {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--sst-text-muted);
    max-width: 52ch;
  }

  .bento__cell--signature .bento__cell-desc {
    color: var(--sst-signature-muted);
  }

  .bento__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }

  .bento__cell--signature .bento__tag {
    background: var(--sst-signature-surface);
    border-color: transparent;
    color: var(--sst-signature-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .bento__cell:hover {
      transform: translateY(-3px);
    }

    .bento__cell:hover .bento__chevron {
      transform: translateX(2px);
    }

    .bento__cell--plain:hover,
    .bento__cell--terminal:hover {
      border-color: var(--sst-brand-200);
    }
  }
</style>
