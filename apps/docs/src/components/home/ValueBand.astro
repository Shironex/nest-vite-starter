---
import Icon from './Icon.astro';
---

<section class="value" aria-labelledby="value-heading">
  <header class="value__head">
    <span class="sst-eyebrow">Why this exists</span>
    <h2 id="value-heading" class="sst-display value__title">
      A durable knowledge layer, not a chatbot.
    </h2>
    <p class="value__sub">
      Deliberately a static site with built-in offline search that stays useful
      even when AI tooling is unavailable. Agents and humans both author into it,
      but nothing here depends on an agent being online to read, search, or reason
      about the system.
    </p>
  </header>

  <div class="value__cards">
    <!-- Search value card: brand-tinted, with a decorative Pagefind input. -->
    <article class="value__card value__card--search">
      <div class="value__card-head">
        <span class="value__icon value__icon--brand">
          <Icon name="search" size={24} />
        </span>
        <span class="value__badge value__badge--brand">Pagefind</span>
      </div>
      <h3 class="value__card-title">Static and searchable</h3>
      <p class="value__card-desc">
        Built with Astro Starlight. A full-text Pagefind index is bundled into the
        build, so search works with no external service and no backend.
      </p>
      <div class="value__search" aria-hidden="true">
        <Icon name="search" size={16} class="value__search-icon" />
        <span class="value__search-text">type-safety chain</span>
        <span class="sst-kbd">⌘K</span>
      </div>
    </article>

    <!-- Markdown value card: plain surface, with a mermaid code snippet. -->
    <article class="value__card value__card--markdown">
      <div class="value__card-head">
        <span class="value__icon value__icon--purple">
          <Icon name="file-text" size={24} />
        </span>
        <span class="value__badge value__badge--neutral">*.md + mermaid</span>
      </div>
      <h3 class="value__card-title">Authored as Markdown</h3>
      <p class="value__card-desc">
        Every page is plain Markdown with Mermaid diagrams. Add a file under the
        right section folder and it appears in the sidebar automatically.
      </p>
      <pre class="value__code" aria-hidden="true"><code>```mermaid
graph TD
  API --&gt; Web
```</code></pre>
    </article>
  </div>
</section>

<style>
  .value {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding-block: 3rem;
    border-top: 1px solid var(--sst-border);
  }

  .value__head {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .value__title {
    font-size: clamp(1.75rem, 3vw, 2rem);
    letter-spacing: -0.025em;
  }

  .value__sub {
    margin: 0;
    max-width: 72ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--sst-text-secondary);
  }

  .value__cards {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 52rem) {
    .value__cards {
      flex-direction: row;
      align-items: stretch;
    }

    .value__card--search {
      flex: 1.4;
    }

    .value__card--markdown {
      flex: 1;
    }
  }

  .value__card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.625rem;
    border-radius: 16px;
    border: 1px solid var(--sst-border);
    background: var(--sst-surface);
  }

  .value__card--search {
    background: var(--sst-brand-50);
    border-color: var(--sst-brand-200);
    box-shadow: var(--sst-shadow-card);
  }

  .value__card-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .value__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.125rem;
    height: 3.125rem;
    border-radius: 12px;
  }

  .value__icon--brand {
    background: var(--sst-brand);
    color: var(--sst-brand-fg);
  }

  .value__icon--purple {
    background: var(--sst-purple-bg);
    color: var(--sst-purple);
  }

  .value__badge {
    margin-left: auto;
    padding: 0.1875rem 0.625rem;
    border-radius: 999px;
    font-size: 0.75rem;
    line-height: 1.35;
  }

  .value__badge--brand {
    background: var(--sst-brand-100);
    color: var(--sst-brand-ink);
    font-family: var(--font-sans);
    font-weight: 500;
  }

  .value__badge--neutral {
    background: var(--sst-subtle);
    border: 1px solid var(--sst-border);
    color: var(--sst-text-muted);
    font-family: var(--font-mono);
  }

  .value__card-title {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    color: var(--sst-text);
  }

  .value__card-desc {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--sst-text-muted);
  }

  .value__search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding: 0.5625rem 0.5rem 0.5625rem 0.75rem;
    border-radius: 10px;
    border: 1px solid var(--sst-border);
    background: var(--sst-surface);
  }

  .value__search-icon {
    color: var(--sst-text-tertiary);
    flex-shrink: 0;
  }

  .value__search-text {
    flex: 1;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--sst-text-placeholder);
  }

  .value__code {
    margin: auto 0 0;
    padding: 0.75rem 0.875rem;
    border-radius: 10px;
    background: var(--sst-signature-bg);
    border: 1px solid var(--sst-signature-border);
    overflow-x: auto;
  }

  .value__code code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #9ec7ff;
    white-space: pre;
  }
</style>
