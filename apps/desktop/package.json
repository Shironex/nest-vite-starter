{
  "name": "@repo/desktop",
  "version": "0.0.1",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && node scripts/dev.mjs",
    "build:main": "tsc -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-renderer.mjs",
    "package": "pnpm build && electron-builder",
    "package:mac": "pnpm build && electron-builder --mac",
    "package:win": "pnpm build && electron-builder --win",
    "package:linux": "pnpm build && electron-builder --linux",
    "test": "node --test \"scripts/*.test.mjs\"",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint .",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/shared": "workspace:*",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/node": "^22.20.2",
    "electron": "^44.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "~5.9.3"
  }
}
