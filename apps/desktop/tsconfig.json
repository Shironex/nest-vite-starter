{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@repo/tsconfig/nestjs.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"]
    },
    // `check-types` is `tsc --noEmit` against THIS config; `build` is
    // `tsc -p tsconfig.build.json`, which emits. The two disagree on `noEmit`,
    // so they must not share a buildinfo file or each run would discard the
    // other's: tsconfig.build.json overrides the path below.
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/check-types.tsbuildinfo"
  },
  "include": ["src"]
}
