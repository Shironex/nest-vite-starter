{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Its own buildinfo, not the one tsconfig.json names: see the comment there.
    "tsBuildInfoFile": "./node_modules/.cache/tsc/build.tsbuildinfo"
