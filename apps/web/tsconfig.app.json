{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@repo/tsconfig/react.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@api/*": ["../api/src/*"]
    },
    // `tsBuildInfoFile` alone did nothing here: `check-types` runs
    // `tsc --noEmit -p`, and that ignores the file unless `incremental` is on,
    // so only `tsc -b` in the build ever wrote it. With both set, a warm
    // `check-types` reuses the previous run's program.
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["src"]
}
