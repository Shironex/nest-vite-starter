{
  "name": "@repo/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fast": "eslint . --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content",
    "check-types": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:cov:check": "vitest run --coverage && node ../../scripts/check-coverage.mjs ./coverage/coverage-summary.json --lines 67 --functions 70",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "knip": "knip",
    "check": "pnpm check-types && pnpm lint && pnpm knip",
    "size:check": "size-limit && node ../../scripts/check-initial-bundle.mjs ./dist --limit 225",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@marsidev/react-turnstile": "^1.6.3",
    "@repo/shared": "workspace:*",
    "@repo/ui": "workspace:*",
    "@sentry/react": "^10.74.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@trpc/client": "^11.28.0",
    "@trpc/tanstack-react-query": "^11.28.0",
    "lucide-react": "1.72.0",
    "qr": "^0.7.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.92.0",
    "superjson": "^2.2.6",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.5",
    "globals": "^17.14.0",
    "happy-dom": "20.11.0",
    "otpauth": "^9.6.0",
    "size-limit": "^14.3.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.0.5"
  }
}
