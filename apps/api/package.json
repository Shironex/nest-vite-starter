{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/src/main.js",
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "default": "./dist/src/main.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "dev": "nest start -b swc -w",
    "build": "nest build -b swc",
    "start": "node dist/src/main",
    "start:prod": "node dist/src/main",
    "lint": "eslint .",
    "check-types": "tsc --noEmit -p tsconfig.build.json --incremental --tsBuildInfoFile node_modules/.cache/tsc/build.tsbuildinfo && tsc -p tsconfig.spec.json",
    "generate:trpc": "nestjs-trpc generate",
    "test": "jest",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.js",
    "test:security": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.security.config.js",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:cov:check": "jest --coverage && node ../../scripts/check-coverage.mjs ./coverage/coverage-summary.json --lines 85 --functions 82",
    "knip": "knip",
    "user:promote": "tsx src/cli/user-promote.ts",
    "check": "pnpm check-types && pnpm lint && pnpm knip && pnpm -w lint:meta && pnpm -w check:lint-meta-docs"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/sdk-trace": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@prisma/instrumentation": "^7.10.0",
    "@repo/database": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/shared": "workspace:*",
    "@sentry/nestjs": "^10.74.0",
    "@trpc/server": "^11.28.0",
    "bullmq": "^6.7.6",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.1.0",
    "disposable-email-domains-js": "^1.26.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "joi": "^18.3.1",
    "nestjs-trpc": "^2.14.1",
    "nodemailer": "^10.5.0",
    "otpauth": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "superjson": "^2.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/ioredis-mock": "^8.2.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "globals": "^17.14.0",
    "ioredis-mock": "^8.13.1",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "typescript": "~5.9.3"
  }
}
