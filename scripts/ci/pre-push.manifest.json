{
  "ciWorkflow": ".github/workflows/ci.yml",
  "requiredCommands": [
    "pnpm build:packages",
    "pnpm exec turbo lint",
    "pnpm exec turbo check-types",
    "pnpm check-types:tools",
    "pnpm lint:meta",
    "pnpm lint:tools",
    "pnpm test:lint-meta",
    "pnpm check:lint-meta-docs",
    "pnpm --filter @repo/api knip",
    "pnpm --filter @repo/web knip",
    "pnpm --filter @repo/api test:cov:check",
    "pnpm --filter @repo/web test:cov:check",
    "pnpm --filter @repo/database db:migrate:check",
    "pnpm --filter @repo/database db:migrate:status",
    "pnpm check:security"
  ]
}
