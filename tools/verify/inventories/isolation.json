{
  "suite": "isolation",
  "cases": {
    "apps/api/src/modules/auth/account-pre-hijack.isolation.spec.ts": {
      "account pre-hijacking > control: register, verify, then sign in with the password still works": 1,
      "account pre-hijacking > the registrant's pre-verification session no longer validates once the owner verifies": 1
    },
    "apps/api/src/modules/auth/login-attempt-budget.isolation.spec.ts": {
      "password lockout under a parallel burst > at most 5 of 8 concurrent wrong-password logins reach argon2": 1,
      "password lockout under a parallel burst > control: a correct password signs in and clears both counters": 1,
      "password lockout under a parallel burst > counting never extends the window: the TTL is set once, on create": 1,
      "password lockout under a parallel burst > the burst still arms the progressive tier in the row": 1
    },
    "apps/api/src/modules/user/admin-set-lock.isolation.spec.ts": {
      "lockAdminSet against real Postgres > executes without a deserialization error": 1,
      "lockAdminSet against real Postgres > is re-entrant within one transaction": 1,
      "lockAdminSet against real Postgres > lets exactly one transaction inside the lock at a time under a burst": 1,
      "lockAdminSet against real Postgres > serializes two competing transactions": 1
    },
    "apps/api/src/modules/user/user-purge-audit-scrub.isolation.spec.ts": {
      "scrub on purge (audit PII registry -> user purge) > erases the declared email fields of a purged user and keeps every audit row": 1,
      "scrub on purge (audit PII registry -> user purge) > leaves a surviving user's declared fields alone": 1
    }
  }
}
