# =============================================================================
# Single source of truth for environment variables. Copy to .env and fill in
# real values. apps/api and apps/web read from this same file via the dotenv
# loader (NestJS `ConfigModule` and Vite's built-in dotenv loader).
#
# Variables prefixed `VITE_` are baked into the SPA bundle at build time; do
# NOT put secrets there.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3000
# Where the web dev server and `vite preview` proxy /trpc, /api and /socket.io.
# Leave unset: it defaults to http://localhost:$PORT, so a second worktree only
# changes PORT above. Set it to point the UI at an API on another host or port.
# Read by apps/web/vite.config.ts at config time; it is not baked into the bundle.
# VITE_API_PROXY_TARGET=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

# Trust-proxy depth. 'loopback' is correct ONLY when the reverse proxy reaches
# the api over 127.0.0.1. Behind a reverse proxy (Traefik, Caddy, nginx) on a Docker bridge network
# it is not: req.ip becomes the proxy address and every per-IP limiter
# (login, register, forgot-password, 2FA, OAuth, invites, ICS, download)
# collapses into one shared bucket, so ten login attempts a minute from one
# client lock those flows for the whole deployment. Use 1 (one hop) there, or a
# number / IP list for a multi-hop chain (CloudFront -> Traefik).
# See https://expressjs.com/en/guide/behind-proxies.html
TRUST_PROXY=loopback

# Comma-separated origin allowlist used by CORS in production. Leave empty in
# dev (the API hard-codes localhost:5173).
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Database (Postgres)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_starter_dev

# Pool sizing: see packages/database/src/client.ts for the math. Bumping
# DB_POOL_MAX requires Postgres `max_connections` headroom.
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# Days the api's audit-log-retention cron keeps AuditLog rows (GDPR storage
# limitation, min 30). Records with a statutory retention belong in their own store.
AUDIT_LOG_RETENTION_DAYS=365

# Days a soft-deleted user account survives before the api's user-purge cron
# hard-deletes the row (FK cascades cover tokens/permissions)
# and its S3 objects (avatars/<userId>/). Min 0 (purge on the next sweep).
USER_PURGE_GRACE_DAYS=30

# -----------------------------------------------------------------------------
# Redis (sessions, cache, BullMQ, throttler, socket.io adapter)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Required by docker-compose.prod.yml when Redis runs behind a password
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_NAME="SaaS Starter"
APP_URL=http://localhost:5173

# IANA time zone the api does calendar-date math in (a date's "day", day
# counts, once-per-day sweep keys) and runs its daily sweeps in: the 04:00
# audit retention is 04:00 in this zone. Defaults to UTC; set it to where your
# users are, e.g. America/New_York or Europe/Berlin. One zone per deployment.
APP_TIME_ZONE=UTC

# Issuer label shown in the user's authenticator app for TOTP two-factor (the
# name before the account email). Leave empty to fall back to APP_NAME; override
# per deployment/brand.
TOTP_ISSUER=

# -----------------------------------------------------------------------------
# SMTP (Mailpit in dev: SMTP on 1025, Web UI on 8025)
# -----------------------------------------------------------------------------
# Email transport: smtp (default, nodemailer) or resend (stub seam).
EMAIL_PROVIDER=smtp
# Only used when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localhost

# -----------------------------------------------------------------------------
# Cloudflare Turnstile
# Dev: 1x0000000000000000000000000000000AA always passes (test key).
# Prod: required, no default; Joi blocks startup if missing.
# -----------------------------------------------------------------------------
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# -----------------------------------------------------------------------------
# CSRF
# Prod: required, no default. Generate via `openssl rand -hex 32`.
# -----------------------------------------------------------------------------
CSRF_SECRET=dev-csrf-secret-change-in-production

# -----------------------------------------------------------------------------
# Encryption-at-rest master key (EncryptionService, AES-256-GCM).
# Always required: the API fails closed at boot if missing/short/low-entropy.
# Must decode to exactly 32 bytes: base64 (`openssl rand -base64 32`) or hex
# (`openssl rand -hex 32`). The placeholder below fails validation on purpose:
# generate a fresh key per environment and never commit a real one.
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

# -----------------------------------------------------------------------------
# Admin seed (used by `pnpm --filter @repo/database db:seed`).
# Seed script refuses to run with NODE_ENV=production.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=P@ssw0rd!Change.Me

# -----------------------------------------------------------------------------
# Dev playground seed (`pnpm db:seed:dev` -> packages/database/prisma/dev.seed.ts).
#
# Fills the `default-organization` tenant with a few staff members and two workspaces, and
# adds a second tiny organization ("Control Organization") so tenant isolation is checkable
# by eye. It refuses to run with NODE_ENV=production and refuses any
# DATABASE_URL host outside a local allowlist. It needs `db:seed` to have run
# first; `db:seed:dev` chains both. Every account it creates uses the password
# P@ssw0rd!Change.Me.
#
# All knobs are optional; the defaults are what you want.
# -----------------------------------------------------------------------------

# Both required together to point the seed at a non-local database host. The
# second must repeat the target database name back, on purpose: a single
# --force flag ends up in a shell history and then in a runbook.
SEED_DEV_ALLOW_REMOTE=
SEED_DEV_CONFIRM_DATABASE=

# -----------------------------------------------------------------------------
# Postgres / Redis credentials for docker-compose.prod.yml
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=saas_starter

# -----------------------------------------------------------------------------
# Frontend (apps/web). VITE_-prefixed values are public; never put secrets here.
# The SPA reaches the API via relative URLs (dev proxy / platform router), so
# no VITE_API_URL exists.
# -----------------------------------------------------------------------------
# Both values below are BUILD arguments, not runtime env: Vite inlines them into
# the bundle. In Docker they must reach the builder stage of apps/web/Dockerfile
# (`--build-arg`, compose `build.args`, or your platform's build variables). Setting them
# on the running web container has no effect. See the deployment doc.
#
# Turnstile site key (public counterpart of TURNSTILE_SECRET_KEY above).
# Production builds MUST set this: when unset the code falls back to the
# always-pass Turnstile test key, which a real TURNSTILE_SECRET_KEY rejects.
VITE_TURNSTILE_SITE_KEY=

# Sentry DSN for web error reporting (public). Empty disables it.
VITE_SENTRY_DSN=

# -----------------------------------------------------------------------------
# OpenTelemetry SDK (apps/api)
# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable the SDK entirely (default
# local-dev path). Setting it to a collector address activates trace + metric
# export over OTLP/HTTP. Logs are NOT shipped via OTel: they remain stdout JSON.
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=@repo/api

# -----------------------------------------------------------------------------
# Sentry (apps/api): runtime error capture only.
# Leave SENTRY_DSN empty to disable Sentry entirely (default; zero egress).
# Set it to your project DSN (self-hosted GlitchTip or Sentry Cloud) to ship
# scrubbed error events. APP_VERSION names the release; SENTRY_ENVIRONMENT
# overrides the NODE_ENV-derived tag. See apps/api/src/otel.ts.
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=
APP_VERSION=

# -----------------------------------------------------------------------------
# Isolation canary (apps/api). LEAVE THIS EMPTY.
# It names one model the tenant-scope extension should not isolate, and exists
# so `pnpm canary:isolation` can prove the isolation lane fails when the tenant
# boundary breaks. The Joi schema forbids it outside NODE_ENV=test, so an API
# process that inherits a value refuses to boot instead of serving requests with
# a model unscoped. The canary runner sets it per mutant run; never set it here.
# -----------------------------------------------------------------------------
ISOLATION_CANARY_DISABLE_MODEL=
