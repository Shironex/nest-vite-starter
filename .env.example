# =============================================================================
# Every environment variable, in one file. Copy to .env and fill in real values.
#
# The api validates its keys at boot (apps/api/src/config/env.ts) and refuses
# to start with a list of every bad key. This file lists exactly those keys,
# plus the few another process reads (marked "read by ..."); the spec
# apps/api/src/config/env-example.spec.ts keeps the two in step.
#
# An empty optional value (KEY=) means "unset". Booleans are exactly true or
# false: an empty boolean is an error, never false.
#
# The values below are for local development against docker-compose.yml, whose
# host ports are offset (Postgres 5442, Valkey 6389, Mailpit SMTP 1035 and UI
# 8035) so it runs beside other projects' stacks.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# development, test or production. Required: a deploy that forgets it would
# otherwise run with dev cookies and none of the production checks.
NODE_ENV=development
PORT=3000
# debug, info, warn or error.
LOG_LEVEL=info

# Reverse-proxy hops in front of the api, as a whole number. 0 (default) when
# clients reach the api directly; 1 behind one proxy (Coolify/Traefik, nginx,
# Caddy, also on a Docker bridge network). With 0 behind a proxy every client
# shares the proxy's IP, so the per-IP login and signup limits lock everyone
# out together. true is refused: it lets any client pick its own IP.
TRUST_PROXY=0

# -----------------------------------------------------------------------------
# Database (Postgres)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5442/nest_vite_starter_dev

# Pool sizing, see packages/database/src/client.ts. Replicas times DB_POOL_MAX
# must stay below Postgres max_connections.
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# -----------------------------------------------------------------------------
# Valkey, Redis-compatible (sessions, cache, BullMQ, throttler)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6389

# Where the BullMQ workers (the mail queue) run. inline (default): inside the
# api process. off: the api only enqueues, and a separate worker process
# consumes (`pnpm --filter @repo/api start:worker`, or `node dist/src/worker`
# from the api image as a second container).
QUEUE_WORKER=inline

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Product name in mail and the authenticator label. Empty uses the built-in name.
APP_NAME=
# The web origin. Base of every mailed link and the default CORS origin.
# Production refuses localhost.
APP_URL=http://localhost:5173

# Comma list of CORS origins (bare origins, no path). Empty means
# APP_URL's origin. Production refuses localhost and loopback entries.
CORS_ORIGINS=

# IANA zone for calendar-date math and the daily sweeps (the 04:00 audit
# retention runs at 04:00 here). One zone per deployment.
APP_TIME_ZONE=UTC

# Issuer label in the user's authenticator app for TOTP. Empty uses APP_NAME.
TOTP_ISSUER=

# Days the audit-log-retention cron keeps AuditLog rows (min 30).
AUDIT_LOG_RETENTION_DAYS=365
# Days a soft-deleted account survives before the purge cron hard-deletes it
# (min 0, purge on the next sweep).
USER_PURGE_GRACE_DAYS=30

# -----------------------------------------------------------------------------
# Mail (SMTP). Dev: Mailpit from docker-compose.yml, SMTP on 1035, UI on 8035.
# Production requires SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS and MAIL_FROM,
# and SMTP_REQUIRE_TLS=true (the default there when unset): mail carries
# password-reset links and the relay credentials.
# -----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1035
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@localhost
# true: STARTTLS is mandatory (port 465 is implicit TLS either way). false:
# STARTTLS only when the server offers it. Mailpit offers none, so dev is false.
SMTP_REQUIRE_TLS=false

# -----------------------------------------------------------------------------
# Captcha (Cloudflare Turnstile)
# Dev: the value below is Cloudflare's public always-pass test secret; empty
# turns the check off. Production refuses empty and refuses the test secrets,
# unless CAPTCHA_DISABLED=true is set (with an empty secret) to run without one.
# -----------------------------------------------------------------------------
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
CAPTCHA_DISABLED=false

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------
# CSRF token secret, 32+ bytes: `openssl rand -hex 32`. Required in production.
# Empty in dev gives a random secret per boot (with a warning), so CSRF tokens
# reset on every restart.
CSRF_SECRET=

# Encryption-at-rest key for TOTP secrets (AES-256-GCM). Required everywhere:
# exactly 32 bytes as base64 (`openssl rand -base64 32`) or hex
# (`openssl rand -hex 32`). The placeholder fails validation on purpose;
# generate one per environment and never commit a real one.
ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

# -----------------------------------------------------------------------------
# Sentry (api): runtime error capture only. Empty SENTRY_DSN means Sentry is
# never initialised (zero egress). APP_VERSION names the release;
# SENTRY_ENVIRONMENT overrides the NODE_ENV-derived tag.
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=
APP_VERSION=

# =============================================================================
# Read by other processes, not the api
# =============================================================================

# -----------------------------------------------------------------------------
# Seeds (read by packages/database). `db:seed` creates this admin and refuses a
# production NODE_ENV. The web e2e specs log in with the same pair.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=P@ssw0rd!Change.Me

# `db:seed:dev` refuses any DATABASE_URL host outside a local allowlist. Both
# are needed together to point it elsewhere, and the second must repeat the
# target database name back.
SEED_DEV_ALLOW_REMOTE=
SEED_DEV_CONFIRM_DATABASE=

# -----------------------------------------------------------------------------
# docker-compose.prod.yml (read by compose for the postgres and redis (Valkey) services)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=nest_vite_starter
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Web (read by apps/web). VITE_ values are public; never put secrets here.
# -----------------------------------------------------------------------------
# Where the web dev server and `vite preview` proxy /trpc and /api. Unset means
# http://localhost:$PORT, so a second worktree only changes PORT above.
# VITE_API_PROXY_TARGET=http://localhost:3000

# BUILD arguments, inlined into the bundle: in Docker they must reach the
# builder stage of apps/web/Dockerfile (--build-arg or compose build.args).
# Production builds must set the Turnstile site key (the public counterpart of
# TURNSTILE_SECRET_KEY); unset falls back to the always-pass test key.
VITE_TURNSTILE_SITE_KEY=
# Web error reporting DSN (public). Empty disables it.
VITE_SENTRY_DSN=
