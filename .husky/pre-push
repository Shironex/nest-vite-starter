# Pre-push: the verify typecheck and test lanes (tests only for packages
# affected since origin/main), and a gitleaks scan over the commits being
# pushed. POSIX sh only, so it runs the same on macOS and in Git Bash on
# Windows. CI runs every lane; this is the fast local subset.
set -eu

ZERO=0000000000000000000000000000000000000000

resolves() {
  git rev-parse --verify --quiet "$1^{commit}" >/dev/null 2>&1
}

main_base=""
if resolves origin/main; then
  main_base="origin/main"
fi

echo "pre-push: verify typecheck"
pnpm verify --lane=typecheck

if [ -n "$main_base" ]; then
  echo "pre-push: verify test, affected since $main_base"
  pnpm verify --lane=test --affected="$main_base"
else
  echo "pre-push: origin/main does not resolve, running every test"
  pnpm verify --lane=test
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks is not installed, skipping the secret scan (CI still runs it)."
  echo "          macOS: brew install gitleaks | Windows: scoop install gitleaks"
  exit 0
fi

# Git passes one line per pushed ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# Scan <base>..<local sha>, where base is the remote sha when the remote already
# has the branch, else origin/main. A base that does not resolve would make
# gitleaks scan zero commits and pass, so that case falls back to full history.
scanned=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  if [ "$local_sha" = "$ZERO" ]; then scanned=1; continue; fi
  base=""
  if [ "$remote_sha" != "$ZERO" ] && resolves "$remote_sha"; then
    base="$remote_sha"
  elif [ -n "$main_base" ]; then
    base="$main_base"
  fi
  if [ -n "$base" ]; then
    echo "pre-push: gitleaks over $base..$local_sha"
    gitleaks git . --config .gitleaks.toml --no-banner --redact --exit-code 1 \
      --log-opts="$base..$local_sha"
  else
    echo "pre-push: no base resolves, gitleaks over the full history"
    gitleaks git . --config .gitleaks.toml --no-banner --redact --exit-code 1
  fi
  scanned=1
done

if [ "$scanned" -eq 0 ]; then
  echo "pre-push: no ref on stdin, gitleaks over the full history"
  gitleaks git . --config .gitleaks.toml --no-banner --redact --exit-code 1
fi
