// ---------------------------------------------------------------------------
// Identity: accounts, the tokens that authenticate them, and second factors.
// ---------------------------------------------------------------------------

// USER and ADMIN are the member roles of an organization. A new role is added here and
// mirrored in ROLES (@repo/shared/permissions); shared-enum-parity.spec.ts keeps
// the two in step.
enum Role {
  USER
  ADMIN
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// Second-factor kind. One table holds every factor type: the login
// challenge and the settings list both want "all factors for this user" in one
// query, and adding WebAuthn later is columns + an enum value, never a new
// table. WEBAUTHN is reserved with NO v1 code path: every query filters by
// `type`, so a reserved value can never leak into a TOTP path.
enum SecondFactorType {
  TOTP
  RECOVERY_CODE
  WEBAUTHN
}

// Lifecycle of a factor row. PENDING = provisioned but not yet verified (TOTP
// enrollment step 1); ACTIVE = confirmed. There is deliberately no REVOKED:
// disable/reset HARD-DELETE the rows and the who/when history lives in AuditLog.
enum SecondFactorStatus {
  PENDING
  ACTIVE
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  displayName       String?
  // Nullable: null means "no password set", never "any password matches".
  // Every credential-verifying path (login, password change, account deletion,
  // the 2FA sudo gate) treats null as a failed verification. Password reset is
  // the one path that ACCEPTS a null hash: it doubles as set-password.
  passwordHash      String?
  role              Role      @default(USER)
  emailVerified     Boolean   @default(false)
  failedAttempts    Int       @default(0)
  lockoutCount      Int       @default(0)
  lockedUntil       DateTime?
  deletedAt         DateTime?
  // Set when a member is removed from the organization without deleting their account.
  // Deliberately NOT modeled as `tenantId = null`: the tenantId comment below
  // explains that a null-tenant user fails every fail-closed tenant-scoped
  // operation AND is invisible to every admin list, which is a worse state than
  // either alternative. Keeping tenantId intact makes the removal visible in the
  // members list and reversible.
  //
  // Enforced at LOGIN and by revokeAuthState, never in auth.middleware, which
  // reads the session blob and never touches the database; a clause there would
  // put a per-request read on the hottest path in the app.
  // The DB-token side door needs the same clause and is easy to miss:
  // password reset.
  membershipEndedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Tenant link is nullable so the existing seeded admin row backfills safely
  // (greenfield) and the seed assigns it; registration will create an organization per
  // signup later. User.email stays globally unique: it is the login identifier.
  // onDelete: Restrict so a Tenant cannot be deleted while users reference it;
  // SET NULL would strand those users with tenantId NULL, which every
  // fail-closed tenant-scoped operation refuses to manage.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // Back-relation for Tenant.ownerId. A user owns at most one organization because
  // tenantId is singular; the @unique on the owning side keeps it that way.
  ownedTenant Tenant? @relation("TenantOwner")

  tokens        Token[]
  auditLogs     AuditLog[]
  secondFactors SecondFactor[]

  // No explicit @@index([email]): the @unique above already maintains a
  // unique B-tree index on email, which findByEmail uses. A second index
  // would only add write amplification.

  // SQL-only partial index "User_deletedAt_idx" ON ("deletedAt") WHERE
  // "deletedAt" IS NOT NULL (in the 0_init baseline): serves the daily
  // user-purge sweep's deletedAt-only predicate, which the composite index
  // above cannot (its leading column is tenantId). Prisma cannot express
  // partial indexes, so it is documented here and lives in the migration.

  // The admin user list filters by { tenantId, deletedAt: null } and orders by
  // createdAt DESC, id DESC (keyset pagination). The index covers both the
  // filter and the order-by, so the read is index-ordered instead of a
  // full-table scan plus sort.
  @@index([tenantId, deletedAt, createdAt(sort: Desc), id(sort: Desc)])
  // The last-admin and live-member guards count over { tenantId, deletedAt:
  // null, membershipEndedAt: null }; the members list reads membershipEndedAt
  // for its status column. This index answers those counts without touching
  // the table.
  @@index([tenantId, deletedAt, membershipEndedAt])
}

model Token {
  id        String    @id @default(cuid())
  userId    String
  type      TokenType
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // No explicit @@index([token]): the @unique above already maintains a
  // unique B-tree index on token, which the lookup uses. A second index
  // would only add write amplification.
  @@index([userId, type])
  // Hourly token-cleanup sweeps `deleteMany({ where: { expiresAt: { lt: now } } })`;
  // without this index that is a full-table scan that grows with the table.
  @@index([expiresAt])
}

// SecondFactor: one type-discriminated table for every second factor.
// It is USER-scoped credential data, like Token (NOT tenant-scoped domain
// data), so it is intentionally absent from TENANT_SCOPED_MODELS and its
// repository lives in the auth module. onDelete: Cascade means the existing
// user-deletion + purge lifecycle cleans factors for free (no purge-cron change).
//
// Payloads are sparse-nullable by type:
//   - TOTP:          `totpSecretEnc` = EncryptionService v1 wire-format string of
//                    the base32 secret; `codeHash`/`usedAt` are null.
//   - RECOVERY_CODE: one row per code; `codeHash` = sha256 hex of the normalized
//                    code, `usedAt` marks single-use redemption; `totpSecretEnc`
//                    is null.
//   - WEBAUTHN:      reserved; columns (credentialId, publicKey, signCount, ...)
//                    are an additive future migration, no v1 rows.
//
// "2FA enabled" is DERIVED, not a column: EXISTS a row with status=ACTIVE and
// type != RECOVERY_CODE. One indexed query on the login hot path, zero drift.
model SecondFactor {
  id     String             @id @default(cuid())
  userId String
  type   SecondFactorType
  status SecondFactorStatus @default(PENDING)

  totpSecretEnc String?
  codeHash      String?
  usedAt        DateTime?

  friendlyName String?
  activatedAt  DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // SQL-only partial UNIQUE index "SecondFactor_active_totp_per_user_key" ON
  // ("userId") WHERE "type" = 'TOTP' AND "status" = 'ACTIVE' (in the
  // 0_init baseline): enforces at most one ACTIVE TOTP factor per user, which the
  // @@unique above cannot (codeHash is NULL for TOTP, so those rows never
  // collide). Prevents a two-tab enrollment race from minting two active secrets
  // + two recovery-code batches. Prisma cannot express partial indexes, so it
  // lives in the migration and is documented here (same pattern as
  // User_deletedAt_idx).

  // Recovery-code redemption is a point lookup by (userId, codeHash). codeHash
  // is null for TOTP rows; Postgres treats NULLs as distinct, so multiple
  // TOTP/pending rows never collide on this unique index.
  @@unique([userId, codeHash])
  // Serves the login "does this user have an active non-recovery factor" check,
  // the settings factor list, and recovery-code lookup prefiltering.
  @@index([userId, type, status])
}
