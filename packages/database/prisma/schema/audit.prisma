// ---------------------------------------------------------------------------
// Audit log: the append-only record of who did what.
// ---------------------------------------------------------------------------

// AuditLog: append-only record of who did what, for compliance / SOC 2 CC7
// / ISO A.12.4 / GDPR Art. 30. Treat as immutable: rows are never updated,
// and the only sanctioned delete path is the api's `audit-log-retention` cron
// (AuditRetentionService), which enforces the AUDIT_LOG_RETENTION_DAYS window
// (default 365 days, GDPR storage limitation) in bounded batches.
//
// userId is nullable so system-driven events (cron jobs, webhooks, scheduled
// migrations) can write entries without a user. Foreign key uses SetNull so
// deleting a user does not orphan-block the trail.
model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  // tenantId / workspaceId are nullable because audit writes can fire pre-auth
  // (e.g. a failed login on an unknown email) with no tenant context yet.
  tenantId      String?
  workspaceId   String?
  action        String
  targetType    String?
  targetId      String?
  before        Json?
  after         Json?
  reason        String?
  ipAddress     String?
  userAgent     String?
  correlationId String?
  success       Boolean  @default(true)
  metadata      Json?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([correlationId])
  // Tenant-scoped "what happened to <entity> within this organization/workspace" lookup.
  @@index([tenantId, workspaceId, targetType, targetId])
  // The audit screen: one organization's trail, newest first, keyset-paged on
  // (createdAt desc, id desc). Without a tenant-leading index carrying the
  // order, Postgres either walks "AuditLog_createdAt_idx" backwards discarding
  // every other organization's rows one at a time, or bitmaps the tenant range and
  // sorts it; both scale with the TOTAL size of the fastest-growing table in
  // the product rather than with the reader's own slice.
  //
  // Serves the `tenantId = $1` arm of the visibility clause only. The second
  // arm (tenantId IS NULL AND the actor belongs to the tenant, which is how
  // pre-auth login rows are attributed) is a join no single-table index can
  // cover; see AuditReadRepository.listPage.
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
}
