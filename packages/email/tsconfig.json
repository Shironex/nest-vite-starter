{
  "extends": "@repo/tsconfig/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "rootDir": "./src",
    "outDir": "./dist",
    // See packages/database/tsconfig.json: `check-types` is `tsc --noEmit` and
    // the build is tsup, so this file is written by the type check alone.
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/check-types.tsbuildinfo"
  },
  "include": ["src"]
}
