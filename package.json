{
  "name": "nest-vite-starter",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "verify": "tsx tools/verify/cli.ts",
    "lint:meta": "tsx node_modules/@noctcore/harness/dist/cli.js lint-meta --registry tools/lint-meta/registry.ts",
    "lint:meta:docs": "tsx node_modules/@noctcore/harness/dist/cli.js catalog --registry tools/lint-meta/registry.ts",
    "lint:tools": "eslint tools",
    "check-types:tools": "tsc -p tools/tsconfig.json",
    "test:tools": "tsx --test \"tools/**/*.test.ts\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "knip": "turbo knip",
    "size:check": "turbo run size:check --filter=@repo/web",
    "check:contrast": "node scripts/check-contrast.mjs",
    "db:seed:dev": "pnpm --filter @repo/database db:seed:dev",
    "postinstall": "node scripts/fix-trpc-native-perms.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@noctcore/eslint-plugin-prisma": "^0.5.2",
    "@noctcore/harness": "^0.3.0",
    "@noctcore/lint-meta-rules": "^1.1.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/node": "^26.6.6",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.13",
    "turbo": "^2.10.13",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=26"
  }
}
