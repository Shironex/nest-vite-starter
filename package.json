{
  "name": "nest-vite-saas-starter",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:packages": "turbo build --filter=./packages/*",
    "dev:packages": "turbo run dev --filter=@repo/shared --filter=@repo/database",
    "db:seed:dev": "pnpm --filter @repo/database db:seed:dev",
    "lint": "turbo lint",
    "lint:fast": "turbo lint:fast --filter=@repo/web",
    "test:lint-cache": "node --test \"scripts/lint-cache-*.test.mjs\"",
    "check-types": "turbo check-types",
    "check-types:tools": "tsc -p tools/tsconfig.json",
    "check:contrast": "node scripts/check-contrast.mjs",
    "size:check": "node scripts/run-web-budget.mjs size:check",
    "lighthouse": "node scripts/run-web-budget.mjs lighthouse",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "verify": "tsx tools/verify/cli.ts",
    "verify:inventory": "tsx tools/verify/inventory-cli.ts",
    "verify:baseline": "tsx tools/verify/baseline-cli.ts",
    "sandbox:up": "tsx tools/verify/sandbox.ts up",
    "sandbox:down": "tsx tools/verify/sandbox.ts down",
    "sandbox:inspect": "tsx tools/verify/sandbox.ts inspect",
    "e2e:lane": "tsx tools/verify/e2e-lane.ts",
    "lint:meta": "tsx node_modules/@noctcore/harness/dist/cli.js lint-meta --registry tools/lint-meta/registry.ts",
    "lint:meta:verify": "pnpm lint:meta",
    "test:lint-meta": "tsx --test \"tools/**/*.test.ts\" \"scripts/hooks/*.test.mjs\"",
    "lint:tools": "eslint tools",
    "generate:arch-map": "tsx tools/arch/build-map.ts",
    "check:arch-map": "tsx tools/arch/build-map.ts --check",
    "generate:lint-meta-docs": "tsx node_modules/@noctcore/harness/dist/cli.js catalog --registry tools/lint-meta/registry.ts",
    "check:lint-meta-docs": "tsx node_modules/@noctcore/harness/dist/cli.js catalog --registry tools/lint-meta/registry.ts --check",
    "new:feature": "tsx tools/codegen/new-feature.ts",
    "new:component": "tsx tools/codegen/new-component.ts",
    "new:finding": "tsx tools/codegen/new-finding.ts",
    "test:security": "pnpm --filter @repo/api test:security",
    "check:security": "tsx tools/quality/check-security-manifest.ts",
    "check:noctcore-published": "tsx tools/quality/check-noctcore-published.ts",
    "ci:local": "bash scripts/ci-local.sh -j quality",
    "ci:local:all": "bash scripts/ci-local.sh",
    "ci:local:build": "bash scripts/ci-local.sh -j build",
    "ci:local:web": "bash scripts/ci-local.sh -j test-web",
    "ci:local:api": "bash scripts/ci-local.sh -j test-api",
    "ci:local:e2e": "bash scripts/ci-local.sh -j test-e2e",
    "ci:local:list": "act -l",
    "postinstall": "node scripts/fix-trpc-native-perms.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@noctcore/eslint-plugin-prisma": "^0.5.2",
    "@noctcore/harness": "^0.3.0",
    "@noctcore/lint-meta-rules": "^0.6.2",
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/node": "^22.20.2",
    "eslint": "^10.15.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.13",
    "turbo": "^2.10.13",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@swc/core",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ],
    "overrides": {
      "@nestjs/common": "^11.0.0",
      "@nestjs/core": "^11.1.18",
      "ioredis": "^5.11.1",
      "react": "^19.2.6",
      "react-dom": "^19.2.6",
      "deepmerge-ts@<8.0.0": "^8.0.2",
      "brace-expansion@>=5.0.0 <5.0.9": "^5.0.9",
      "ip-address@>=10.1.1 <=10.2.1": "^10.2.2",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1",
      "find-my-way@<=9.6.0": "^9.7.0",
      "js-yaml@<4.3.2": "^4.3.2",
      "tmp@<0.2.6": "^0.2.6",
      "uuid@<11.1.1": "^11.1.1",
      "valibot@<=1.4.1": "^1.4.2",
      "fast-uri@<3.1.6": "^3.1.6",
      "mysql2@<3.23.1": "^3.23.1",
      "multer@<2.3.0": "^2.3.0",
      "qs@<6.16.0": "^6.16.0",
      "ws@>=8.0.0 <8.21.0": "^8.21.0"
    }
  }
}
