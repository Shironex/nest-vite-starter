{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "ADMIN_EMAIL",
    "ADMIN_PASSWORD",
    "ALLOW_PRODUCTION_SEED",
    "APP_TIME_ZONE",
    "APP_URL",
    "APP_VERSION",
    "CI",
    "CORS_ORIGINS",
    "DATABASE_URL",
    "DEV",
    "ENCRYPTION_KEY",
    "MEMBER_EMAIL",
    "MEMBER_PASSWORD",
    "MODE",
    "NODE_ENV",
    "REDIS_URL",
    "SEED_DEV_ALLOW_REMOTE",
    "SEED_DEV_CONFIRM_DATABASE",
    "SENTRY_DSN",
    "SENTRY_ENVIRONMENT",
    "TZ",
    "npm_package_version"
  ],
  "globalPassThroughEnv": ["HOME", "LOGNAME", "USER", "USERNAME", "USERPROFILE"],
  "tasks": {
    "db:generate": {
      "cache": false,
      "inputs": ["packages/database/prisma/schema/**/*.prisma"],
      "env": ["DATABASE_URL"]
    },
    "@repo/api#generate:trpc": {
      "cache": false,
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "!src/@generated/**"],
      "outputs": ["src/@generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "!dist/cache/**"]
    },
    "@repo/api#build": {
      "dependsOn": ["^build", "db:generate", "@repo/api#generate:trpc"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "!dist/cache/**"]
    },
    "@repo/web#build": {
      "dependsOn": ["^build", "@repo/api#generate:trpc"],
      "env": ["VITE_SENTRY_DSN", "VITE_TURNSTILE_SITE_KEY"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "@repo/web#check-types": {
      "dependsOn": ["^build", "@repo/api#generate:trpc"]
    },
    "@repo/api#check-types": {
      "dependsOn": ["^build", "@repo/api#generate:trpc"]
    },
    "@repo/web#size:check": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@repo/web#lint": {
      "dependsOn": ["^build", "@repo/api#generate:trpc"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT", "VITE_API_PROXY_TARGET"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "lint:fast": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@repo/web#lint:fast": {
      "dependsOn": ["^build", "@repo/api#generate:trpc"],
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["PLAYWRIGHT_BASE_URL", "MAILPIT_URL"]
    }
  }
}
